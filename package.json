{
  "name": "content-to-markdown-extension",
  "version": "1.0.0",
  "description": "Chrome and Edge extension that convert page or selected content on a page into markdown",
  "main": "index.js",
  "scripts": {
    "build": "webpack --mode production",
    "build:dev": "webpack --mode development",
    "watch": "webpack --mode development --watch",
    "test": "tsc -p tsconfig.test.json && node --test test/*.test.cjs",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "chrome-extension",
    "markdown",
    "converter"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.4",
    "@types/turndown": "^5.0.6",
    "copy-webpack-plugin": "^14.0.0",
    "jsdom": "^30.1.1",
    "ts-loader": "^9.6.2",
    "typescript": "~6.0.3",
    "webpack": "^5.111.1",
    "webpack-cli": "^7.2.3"
  },
  "engines": {
    "node": ">=22.12"
  }
}
